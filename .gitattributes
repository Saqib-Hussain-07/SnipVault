# Auto detect text files and perform LF normalization
* text=auto

# Custom override to preserve line endings for files that require CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.svg      binary
*.pdf      binary
