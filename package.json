{
  "name": "snipvault-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo workspace for SnipVault - Code Snippet Manager",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev --workspace=snipvault-server",
    "dev:client": "npm run dev --workspace=client",
    "start:server": "npm run start --workspace=snipvault-server",
    "build:client": "npm run build --workspace=client",
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "start": "concurrently --kill-others-on-fail \"npm:start:server\" \"npm:dev:client\"",
    "lint": "npm run lint --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
